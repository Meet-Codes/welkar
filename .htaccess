<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and directories
    RewriteRule ^(\.env|config|database|storage|tests|resources|app) - [F,L,NC]

    # If already in public directory or requesting a real file in public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback index
DirectoryIndex index.php public/index.php
