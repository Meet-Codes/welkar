# Welkar E-Commerce Environment Configuration
APP_NAME="Welkar"
APP_ENV="local"
APP_DEBUG="true"
APP_URL="http://localhost:8000"
APP_KEY="base64:welkar_in_secure_random_key_production_32b"
APP_TIMEZONE="Asia/Kolkata"

# Database (MySQL 8.0+ / MariaDB 10.11+)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="welkar_db"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"

# Currency & Locale
DEFAULT_CURRENCY="INR"
CURRENCY_SYMBOL="₹"
DEFAULT_LOCALE="en"
FALLBACK_LOCALE="en"

# Business & GST Details (To be verified by owner/accountant)
BUSINESS_LEGAL_NAME="Welkar Timepieces Private Limited"
BUSINESS_TRADE_NAME="Welkar"
BUSINESS_GSTIN=""
BUSINESS_PAN=""
BUSINESS_ADDRESS_LINE1=""
BUSINESS_CITY=""
BUSINESS_STATE="Maharashtra"
BUSINESS_STATE_CODE="27"
BUSINESS_PINCODE=""
BUSINESS_EMAIL="welkarstore@gmail.com"
BUSINESS_PHONE=""
DEFAULT_GST_RATE="18.00"

# Shipping Configuration
DEFAULT_SHIPPING_FEE="60.00"
FREE_SHIPPING_THRESHOLD="1499.00"
COD_ENABLED="true"
COD_MAX_AMOUNT="5000.00"

# Razorpay Payment Gateway (Test Mode by default)
RAZORPAY_MODE="test"
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET=""

# Email - Gmail SMTP
MAIL_DRIVER="smtp"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="welkarstore@gmail.com"
MAIL_FROM_NAME="Welkar Watches"

# SMS & WhatsApp Adapters (Disabled until credentials configured)
SMS_ENABLED="false"
SMS_PROVIDER="dummy"
SMS_API_KEY=""
SMS_SENDER_ID=""

WHATSAPP_ENABLED="false"
WHATSAPP_PROVIDER="dummy"
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Analytics & Ad Tracking (Set unconfigured by default)
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""
META_PIXEL_ID=""
META_CONVERSIONS_API_TOKEN=""
GOOGLE_ADS_CONVERSION_ID=""

# Admin Security
ADMIN_MFA_ENABLED="false"
SESSION_LIFETIME="7200"
